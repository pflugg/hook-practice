{
  "name": "hook-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Neverland Duel — an independent board-game teaching prototype with guided lessons, move explanations, and focused practice.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-submission.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/verify.mjs prove",
    "verify:submission": "npm run build && node scripts/verify-submission.mjs",
    "video": "node scripts/render-explainer.mjs",
    "soak": "vite-node scripts/soak-games.ts -- --games 200 --out /tmp/hook-soak/summary.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
